<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="吹气反馈"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:padding="8dp" />

        <com.voice.control.BlowBarView
            android:id="@+id/blowBar"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#0d0d1a"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="平均统计 (去除极端值)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvCollectAvg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:text="暂无统计数据"
            android:textSize="13sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="吹气采集"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Spinner
                android:id="@+id/spinCollectType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCollect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始采集"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnClearStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空统计"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCollectResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择命令类型后点开始采集"
            android:textSize="13sp"
            android:textColor="#666666"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="采集记录"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:padding="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCollectHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#333333"
                android:padding="6dp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="monospace" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="参数调节 (每tick约8ms)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="吹气阈值 (BLOW_THRESHOLD)"
            android:textSize="14sp"
            android:textColor="#333333" />

        <SeekBar
            android:id="@+id/seekThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10000"
            android:progress="2500" />

        <TextView
            android:id="@+id/tvThresholdVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2500"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="短吹上限 (SHORT_MAX_TICK ~8ms/tick)"
            android:textSize="14sp"
            android:textColor="#333333" />

        <SeekBar
            android:id="@+id/seekShortMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="96"
            android:progress="40" />

        <TextView
            android:id="@+id/tvShortMaxVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="40t (~320ms)"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中吹上限 (MID_MAX_TICK ~8ms/tick)"
            android:textSize="14sp"
            android:textColor="#333333" />

        <SeekBar
            android:id="@+id/seekMidMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="128"
            android:progress="80" />

        <TextView
            android:id="@+id/tvMidMaxVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80t (~640ms)"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="组合等待 (COMBO_WAIT_TICK ~8ms/tick)"
            android:textSize="14sp"
            android:textColor="#333333" />

        <SeekBar
            android:id="@+id/seekComboWait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="160"
            android:progress="80" />

        <TextView
            android:id="@+id/tvComboWaitVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80t (~640ms)"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最小间隔 (MIN_GAP_TICK ~8ms/tick)"
            android:textSize="14sp"
            android:textColor="#333333" />

        <SeekBar
            android:id="@+id/seekMinGap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="6" />

        <TextView
            android:id="@+id/tvMinGapVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6t (~48ms)"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长吹重复间隔 (LONG_REPEAT_TICK)"
            android:textSize="14sp"
            android:textColor="#333333" />

        <SeekBar
            android:id="@+id/seekLongRepeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="128"
            android:progress="10" />

        <TextView
            android:id="@+id/tvLongRepeatVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10t (~80ms)"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← 左滑返回控制页面"
            android:textSize="12sp"
            android:textColor="#999999"
            android:gravity="center"
            android:padding="4dp" />

    </LinearLayout>
</ScrollView>
