<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@color/surface_mid"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_home"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp"
            app:cornerRadius="14dp"
            app:rippleColor="@color/surface_overlay" />

        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="实时监测"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@color/surface_overlay" />

        <TextView
            android:id="@+id/tv_bar_patient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="患者:未选"
            android:textColor="@color/accent_info"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@color/surface_overlay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bar_record"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="BDF记录"
            android:textColor="@color/accent_error"
            android:textSize="11sp"
            app:cornerRadius="6dp"
            app:rippleColor="@color/surface_overlay" />

        <View


            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_bar_focus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="专注:--%"
            android:textColor="@color/focus_line"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_bar_relax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="放松:--%"
            android:textColor="@color/accent_info"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_bar_instant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="瞬时:-"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_bar_trend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="趋势:-"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@color/surface_overlay" />

        <TextView
            android:id="@+id/tv_bar_posture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="姿态:- 翻身:0"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@color/surface_overlay" />

        <View
            android:id="@+id/status_indicator"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_status_indicator" />

        <TextView
            android:id="@+id/tv_status_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
