<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_base">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/surface_low"
        app:strokeColor="@color/surface_overlay"
        app:strokeWidth="0.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_toggle_focus"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="专注度"
                android:textColor="@color/focus_line"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_param_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_toggle_relax"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:layout_marginStart="6dp"
                android:text="放松度"
                android:textColor="@color/accent_info"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_param_chip"
                android:clickable="true"
                android:focusable="true" />


            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_focus_label_count"
                style="@style/FocusValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:visibility="gone" />

            <TextView
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 标签 "
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_focus_range"
                style="@style/FocusValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.00 Focus"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_focus_x_range"
                style="@style/FocusValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20.0 s" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_low"
            app:strokeColor="@color/surface_overlay"
            app:strokeWidth="0.5dp">

            <com.nihilisttt.eegdoctor.FocusChartView
                android:id="@+id/focus_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="0.30"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_low"
            app:strokeColor="@color/surface_overlay"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="专注训练"
                    android:textColor="@color/focus_line"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Stroop 颜色辨字"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btn_stroop_start"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="开始训练"
                    android:textColor="@color/focus_line"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_param_chip"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_stroop_stop"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="停止训练"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:alpha="0.5"
                    android:background="@drawable/bg_param_chip"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_stroop_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="未开始"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="眼镜中显示颜色字\n每5秒切换一组"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
