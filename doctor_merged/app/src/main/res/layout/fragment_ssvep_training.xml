<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/surface_base"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3.5"
        android:orientation="vertical"
        android:layout_marginEnd="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O1 波形"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:padding="6dp" />
        <com.nihilisttt.eegdoctor.WaveformView
            android:id="@+id/wave_o1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OZ 波形"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:padding="6dp" />
        <com.nihilisttt.eegdoctor.WaveformView
            android:id="@+id/wave_oz"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O1 频谱"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:padding="6dp" />
        <com.nihilisttt.eegdoctor.SpectrumView
            android:id="@+id/spectrum_o1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:spectrumColor="@color/spectrum_bar"
            app:spectrumColorEnd="@color/spectrum_bar_end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oz 频谱"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:padding="6dp" />
        <com.nihilisttt.eegdoctor.SpectrumView
            android:id="@+id/spectrum_oz"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:spectrumColor="@color/accent_info"
            app:spectrumColorEnd="@color/brand_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:fillViewport="true"
        android:layout_marginStart="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface_mid"
                app:strokeColor="@color/surface_overlay"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:text="波形"
                        style="@style/ControlLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tv_wave_type"
                        android:text="滤波"
                        style="@style/ParamChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="幅度"
                        style="@style/ControlLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tv_wave_y_range"
                        style="@style/ParamChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500uV" />

                    <TextView
                        android:text="时间"
                        style="@style/ControlLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tv_wave_x_range"
                        style="@style/ParamChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.05 s" />

                    <TextView
                        android:text="刻度"
                        style="@style/ControlLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tv_wave_label_count"
                        style="@style/ParamChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface_mid"
                app:strokeColor="@color/surface_overlay"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:text="频率"
                        style="@style/ControlLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tv_spec_x_range"
                        style="@style/ParamChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0-30 Hz" />

                    <TextView
                        android:text="幅度"
                        style="@style/ControlLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" />

                    <TextView
                        android:id="@+id/tv_spec_y_range"
                        style="@style/ParamChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500 uV" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_ssvep_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="状态: 空闲"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_selected_freq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前目标: 未选择"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_freq_11"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:text="11 Hz\n上" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_freq_13"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:text="13 Hz\n下" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_freq_15"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:text="15 Hz\n左" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_freq_17"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:text="17 Hz\n右" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ssvep_start"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:text="真实脑电测试" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ssvep_self_test"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="无设备算法自测" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ssvep_stop"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="0.7"
                    android:layout_marginStart="6dp"
                    android:text="停止"
                    android:enabled="false" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_ssvep_window"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:layout_marginTop="10dp" />
            <TextView
                android:id="@+id/tv_ssvep_progress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="窗口: 0 / 1250" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:paddingTop="4dp" />
            <TextView
                android:id="@+id/tv_ssvep_wave_source"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="波形源: --" android:textColor="@color/text_secondary"
                android:textSize="12sp" android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="投票结果" android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tv_ssvep_result"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="--" android:textSize="30sp" android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/tv_ssvep_raw_result"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="原始判决: --" android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_ssvep_scores"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="11: --   13: --   15: --   17: --"
                android:textColor="@color/text_primary" android:textSize="14sp"
                android:paddingTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingTop="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ratio: " android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tv_ssvep_ratio"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="--" android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Margin: " android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tv_ssvep_margin"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="--" android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ssvep_vote"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="投票: --" android:textColor="@color/text_secondary"
                android:paddingTop="6dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
